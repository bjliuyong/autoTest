# Gate AutoTest Python HTTP 后端配置文件（离线部署直接修改本文件即可）
HOST=0.0.0.0
PORT=3100

# 数据库类型: postgres (默认推荐，PostgreSQL) / sqlite (单机测试)
DB_TYPE=postgres

# PostgreSQL 连接配置（离线部署前请先建库: CREATE DATABASE gate_autotest;）
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=gate_autotest

# JWT 密钥（团队生产部署建议改为随机长字符串）
JWT_SECRET=gate-autotest-shared-secret-2026
