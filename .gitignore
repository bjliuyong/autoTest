# ==========================================
# 构建产物与打包文件 (Build Artifacts)
# ==========================================
dist/
dist-offline/
out/
build/
*.sqlite
*.sqlite.tmp
*.db
*.db-wal
*.db-shm
backend-python/data/
target/
*.jar
*.war
*.ear
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# ==========================================
# 前端与 Node 依赖 (Frontend / Node)
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ==========================================
# 自动化测试脚本运行产物 (Autotest Run Artifacts)
# ==========================================
runs/
runs-*/
autotest-scripts/runs/
autotest-scripts/runs-*/
autotest-scripts/dist/
*.log
logs/

# 离线部署与依赖缓存
vendor/
autotest-scripts/vendor/

# DSH 隔离 home（含凭据，绝不能提交）
.dsh-home/
.dsh-home*/

# Python 缓存
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
autotest-scripts/__pycache__/
autotest-scripts/**/__pycache__/

# 测试临时目录
.tmp-tests/
.tmp-tests*/
tmp-plain/
tests/tmp-probe/
autotest-scripts/.tmp-tests/
autotest-scripts/.tmp-tests*/

# ==========================================
# IDE 与编辑器临时文件 (IDE & Editor)
# ==========================================
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
.DS_Store
Thumbs.db
