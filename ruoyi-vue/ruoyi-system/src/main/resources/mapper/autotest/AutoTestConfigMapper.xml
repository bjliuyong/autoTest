<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.autotest.mapper.AutoTestConfigMapper">
    
    <resultMap type="AutoTestConfig" id="AutoTestConfigResult">
        <result property="configId"              column="config_id"               />
        <result property="configName"            column="config_name"             />
        <result property="gateWsUrl"             column="gate_ws_url"              />
        <result property="logWsUrl"              column="log_ws_url"               />
        <result property="isGateServer"          column="is_gate_server"           />
        <result property="gateServerPort"        column="gate_server_port"         />
        <result property="timeoutSeconds"        column="timeout_seconds"          />
        <result property="sessionCreatePattern"  column="session_create_pattern"   />
        <result property="nodeFailurePattern"    column="node_failure_pattern"     />
        <result property="passengerExitPattern"  column="passenger_exit_pattern"   />
        <result property="nodeAliases"           column="node_aliases"            />
        <result property="isDefault"             column="is_default"              />
        <result property="remark"                column="remark"                  />
        <result property="createTime"            column="create_time"             />
        <result property="updateTime"            column="update_time"             />
    </resultMap>

    <sql id="selectAutoTestConfigVo">
        select config_id, config_name, gate_ws_url, log_ws_url, is_gate_server, gate_server_port, timeout_seconds, session_create_pattern, node_failure_pattern, passenger_exit_pattern, node_aliases, is_default, remark, create_time, update_time from auto_test_config
    </sql>

    <select id="selectAutoTestConfigList" parameterType="AutoTestConfig" resultMap="AutoTestConfigResult">
        <include refid="selectAutoTestConfigVo"/>
        <where>  
            <if test="configName != null and configName != ''"> and config_name like concat('%', #{configName}, '%')</if>
            <if test="isDefault != null"> and is_default = #{isDefault}</if>
        </where>
        order by config_id desc
    </select>
    
    <select id="selectAutoTestConfigByConfigId" parameterType="Long" resultMap="AutoTestConfigResult">
        <include refid="selectAutoTestConfigVo"/>
        where config_id = #{configId}
    </select>

    <select id="selectDefaultConfig" resultMap="AutoTestConfigResult">
        <include refid="selectAutoTestConfigVo"/>
        where is_default = 1
        limit 1
    </select>
        
    <insert id="insertAutoTestConfig" parameterType="AutoTestConfig" useGeneratedKeys="true" keyProperty="configId">
        insert into auto_test_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="configName != null and configName != ''">config_name,</if>
            <if test="gateWsUrl != null">gate_ws_url,</if>
            <if test="logWsUrl != null">log_ws_url,</if>
            <if test="isGateServer != null">is_gate_server,</if>
            <if test="gateServerPort != null">gate_server_port,</if>
            <if test="timeoutSeconds != null">timeout_seconds,</if>
            <if test="sessionCreatePattern != null">session_create_pattern,</if>
            <if test="nodeFailurePattern != null">node_failure_pattern,</if>
            <if test="passengerExitPattern != null">passenger_exit_pattern,</if>
            <if test="nodeAliases != null">node_aliases,</if>
            <if test="isDefault != null">is_default,</if>
            <if test="remark != null">remark,</if>
            create_time
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="configName != null and configName != ''">#{configName},</if>
            <if test="gateWsUrl != null">#{gateWsUrl},</if>
            <if test="logWsUrl != null">#{logWsUrl},</if>
            <if test="isGateServer != null">#{isGateServer},</if>
            <if test="gateServerPort != null">#{gateServerPort},</if>
            <if test="timeoutSeconds != null">#{timeoutSeconds},</if>
            <if test="sessionCreatePattern != null">#{sessionCreatePattern},</if>
            <if test="nodeFailurePattern != null">#{nodeFailurePattern},</if>
            <if test="passengerExitPattern != null">#{passengerExitPattern},</if>
            <if test="nodeAliases != null">#{nodeAliases},</if>
            <if test="isDefault != null">#{isDefault},</if>
            <if test="remark != null">#{remark},</if>
            sysdate()
         </trim>
    </insert>

    <update id="resetDefaultFlag">
        update auto_test_config set is_default = 0
    </update>

    <update id="updateAutoTestConfig" parameterType="AutoTestConfig">
        update auto_test_config
        <trim prefix="SET" suffixOverrides=",">
            <if test="configName != null and configName != ''">config_name = #{configName},</if>
            <if test="gateWsUrl != null">gate_ws_url = #{gateWsUrl},</if>
            <if test="logWsUrl != null">log_ws_url = #{logWsUrl},</if>
            <if test="isGateServer != null">is_gate_server = #{isGateServer},</if>
            <if test="gateServerPort != null">gate_server_port = #{gateServerPort},</if>
            <if test="timeoutSeconds != null">timeout_seconds = #{timeoutSeconds},</if>
            <if test="sessionCreatePattern != null">session_create_pattern = #{sessionCreatePattern},</if>
            <if test="nodeFailurePattern != null">node_failure_pattern = #{nodeFailurePattern},</if>
            <if test="passengerExitPattern != null">passenger_exit_pattern = #{passengerExitPattern},</if>
            <if test="nodeAliases != null">node_aliases = #{nodeAliases},</if>
            <if test="isDefault != null">is_default = #{isDefault},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </trim>
        where config_id = #{configId}
    </update>

    <delete id="deleteAutoTestConfigByConfigId" parameterType="Long">
        delete from auto_test_config where config_id = #{configId}
    </delete>

    <delete id="deleteAutoTestConfigByConfigIds" parameterType="String">
        delete from auto_test_config where config_id in 
        <foreach item="configId" collection="array" open="(" separator="," close=")">
            #{configId}
        </foreach>
    </delete>
</mapper>
